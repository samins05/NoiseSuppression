+/* ---- oracle instrumentation (added for NoiseSuppression project verification) ----
+   When the RNNOISE_DUMP env var names a file, dump per-stage intermediates for each
+   frame so our reimplementation can diff against this reference. Text, one block/frame:
+     FRAME silence=<0|1> vad=<f>
+     Ex   <22 band energies>
+     FEAT <42 features fed to the RNN>
+     GRNN <22 raw gains straight out of compute_rnn>
+     GFIN <22 final gains after pitch_filter + smoothing (what actually gets applied)>
+   No-op unless RNNOISE_DUMP is set, so the pristine denoise path is unaffected. */
+static FILE *rnnoise_dump_file(void) {
+  static FILE *f = NULL;
+  static int tried = 0;
+  if (!tried) {
+    const char *path = getenv("RNNOISE_DUMP");
+    if (path) f = fopen(path, "wb");
+    tried = 1;
+  }
+  return f;
+}
+static void rnnoise_dump_frame(const float *features, const float *g_rnn,
+                               const float *g_final, const float *Ex,
+                               int silence, float vad) {
+  int i;
+  FILE *f = rnnoise_dump_file();
+  if (!f) return;
+  fprintf(f, "FRAME silence=%d vad=%.9g\n", silence, vad);
+  fprintf(f, "Ex");   for (i=0;i<NB_BANDS;i++)    fprintf(f, " %.9g", Ex[i]);       fprintf(f, "\n");
+  fprintf(f, "FEAT"); for (i=0;i<NB_FEATURES;i++) fprintf(f, " %.9g", features[i]); fprintf(f, "\n");
+  fprintf(f, "GRNN"); for (i=0;i<NB_BANDS;i++)    fprintf(f, " %.9g", g_rnn[i]);    fprintf(f, "\n");
+  fprintf(f, "GFIN"); for (i=0;i<NB_BANDS;i++)    fprintf(f, " %.9g", g_final[i]);  fprintf(f, "\n");
+}
+/* ---- end oracle instrumentation ---- */
+
